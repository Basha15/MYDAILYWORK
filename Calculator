num1 = int(input("Enter the number: "))
num2 = int(input("Enter the number: "))
while True:
    print("\n Select the operation: ")
    print(" + ")
    print(" - ")
    print(" * ")
    print(" / ")
    print(" % ")
    choice = input("Select the operation: ")
    if choice == "+":
        result = num1+num2
        print("The sum of two numbers is:", result)
    elif choice == "-":
        result = num1-num2
        print("Difference of two numbers is:", result)
    elif choice == "*":
        result = num1*num2
        print("The multiplication of two numbers is:", result)
    elif choice == "/":
        result = num1//num2
        print("The division of two numbers is:", result)
    elif choice == "%":
        result = num1 % num2
        print("The mod of two numbers is:", result)
    else:
        print("Invalid choice, Sorry")
        break
