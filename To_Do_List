tasks = []
while True:
    print("\n Select the options")
    print("1. Add Task")
    print("2. View Task")
    print("3. Remove Task")
    print("4. Exit")
    choice = input("Select the options (1-4): ")
    if choice == "1":
        task1 = input("Which task do you want to add: ")
        tasks.append(task1)
    elif choice == "2":
        print("\n--- Your Tasks ---")
        for task in tasks:
            print("-> " + task)
    elif choice == "3":
        task = input("Which task do you want to remove: ")
        if task in tasks:
            tasks.remove(task)
            print("Successfully removed")
        else:
            print("The task is not available")
    else:
        print("\n Thank you")
        break
